<Window x:Class="Murmur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murmur" Height="220" Width="380"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="Murmur" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="TalkStateText" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
