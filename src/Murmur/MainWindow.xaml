<Window x:Class="Murmur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murmur" Height="340" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Murmur" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="SpeechStatusText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="TalkStateText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="TranscriptBox" Height="80" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        <Button x:Name="HistoryButton" Content="History" Margin="0,8,0,0"
                HorizontalAlignment="Left" Padding="8,2" Click="OnHistoryButtonClick"/>
    </StackPanel>
</Window>
