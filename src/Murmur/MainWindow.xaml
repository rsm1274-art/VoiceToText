<Window x:Class="Murmur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murmur" Height="400" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Murmur" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="SpeechStatusText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Engine:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="EngineSelector" Width="220"
                      SelectionChanged="OnEngineSelectionChanged"/>
        </StackPanel>
        <TextBlock x:Name="TalkStateText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="TranscriptBox" Height="80" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="HistoryButton" Content="History" Padding="8,2"
                    Margin="0,0,8,0" Click="OnHistoryButtonClick"/>
            <Button x:Name="DictionaryButton" Content="Dictionary" Padding="8,2"
                    Click="OnDictionaryButtonClick"/>
        </StackPanel>
    </StackPanel>
</Window>
