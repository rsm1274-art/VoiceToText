<Window x:Class="Murmur.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murmur - Custom Dictionary" Height="480" Width="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Term is the correct spelling. Aliases (comma-separated, optional) are phrases the recognizer commonly produces instead - they get replaced with Term after each transcription."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="TermBox" Width="150" Margin="0,0,8,0"
                     ToolTip="Correct term, e.g. Kubernetes"/>
            <TextBox x:Name="AliasesBox" Width="260" Margin="0,0,8,0"
                     ToolTip="Common mis-hearings, comma-separated, e.g. cooper netties, cooper nettis"/>
            <Button Content="Add" Padding="8,2" Click="OnAddClick"/>
        </StackPanel>

        <ListView x:Name="EntriesList" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Term" Width="150" DisplayMemberBinding="{Binding Term}"/>
                    <GridViewColumn Header="Aliases" Width="300" DisplayMemberBinding="{Binding AliasesCsv}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Grid.Row="3" Content="Delete Selected" Margin="0,8,0,0"
                HorizontalAlignment="Left" Padding="8,2" Click="OnDeleteClick"/>
    </Grid>
</Window>
